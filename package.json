{
  "name": "downcat",
  "version": "0.2.0",
  "description": "받냥이 - URL 붙여넣으면 영상/이미지를 폴더로 정리해 받는 바탕화면 다운로더",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dl": "node engine.js",
    "test": "node --test test_aria2.js test_bridge.js test_engine.js test/engine-cases.test.js test/encoding-real.test.js test/tools.test.js test/bridge-pair.test.js",
    "pack-crx": "node scripts/pack-crx.js",
    "dist": "node scripts/pack-crx.js && electron-builder --win nsis",
    "dist:app": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^25.1.8",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.downcat.app",
    "productName": "받냥이",
    "asar": false,
    "afterPack": "build/after-pack.js",
    "files": [
      "**/*",
      "!cookies/**",
      "!downloads/**",
      "!thumbs/**",
      "!docs/**",
      "!reference/**",
      "!build/**",
      "build/downcat-ext.crx",
      "!config.json",
      "!tasks.json",
      "!**/*.md",
      "!받냥이.bat",
      "!test/**",
      "!test_*.js",
      "!bin/tools.json",
      "!bin/*.old-*",
      "!bin/.downcat-tmp/**",
      "!logs/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "받냥이",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
