{
  "name": "downcat",
  "version": "0.1.1",
  "description": "받냥이 - URL 붙여넣으면 영상/이미지를 폴더로 정리해 받는 바탕화면 다운로더",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dl": "node engine.js",
    "pack-crx": "node scripts/pack-crx.js",
    "dist": "node scripts/pack-crx.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.downcat.app",
    "productName": "받냥이",
    "asar": false,
    "afterPack": "build/after-pack.js",
    "files": [
      "**/*",
      "!cookies/**",
      "!downloads/**",
      "!thumbs/**",
      "!docs/**",
      "!reference/**",
      "!build/**",
      "build/downcat-ext.crx",
      "!config.json",
      "!tasks.json",
      "!**/*.md",
      "!받냥이.bat"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "받냥이",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
