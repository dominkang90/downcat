{
  "manifest_version": 3,
  "name": "받냥이로 받기",
  "version": "0.1.0",
  "description": "지금 보는 페이지의 파일·링크를 쿠키·referer·UA와 함께 받냥이로 원클릭 다운로드.",
  "key": "",
  "permissions": ["contextMenus", "cookies", "storage", "webRequest", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:47653/*"],
  "storage": { "managed_schema": "managed_schema.json" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "받냥이" }
}
